# Firebase (client)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_DATABASE_ID=

# Optional dev server / APK base URL (health check only)
VITE_API_BASE_URL=

# Cloud Functions base (defaults to https://us-central1-{PROJECT_ID}.cloudfunctions.net)
VITE_FUNCTIONS_BASE_URL=

# OneSignal (client — App ID only; REST key stays on server)
VITE_ONESIGNAL_APP_ID=

# Cloud Functions — set via: firebase functions:secrets:set ONESIGNAL_APP_ID ONESIGNAL_REST_API_KEY
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=

# Server-only secrets (never prefix with VITE_)
WASENDER_ACCESS_TOKEN=
WASENDER_INSTANCE_ID=
GEMINI_API_KEY=
