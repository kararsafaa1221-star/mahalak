# =============================================================================
# Mahalak Admin Panel — Environment Template
# Copy to: apps/admin/.env
# =============================================================================

# OneSignal App ID — Mahalak Admin App (Web Push on browser, including Android Chrome)
# From: OneSignal → Mahalak Admin App → Settings → Keys & IDs
VITE_ONESIGNAL_APP_ID=YOUR_ADMIN_ONESIGNAL_APP_ID

# Optional server secrets (Firebase Functions — push TO admin staff):
# ADMIN_ONESIGNAL_APP_ID + ADMIN_ONESIGNAL_REST_API_KEY
# Set via: scripts/setup-onesignal-secrets.ps1 with MAHALAK_ONESIGNAL_ADMIN_APP_ID / _REST_KEY
