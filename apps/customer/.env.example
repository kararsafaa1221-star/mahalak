# =============================================================================
# Mahalak Customer App — Production Environment Template
# Copy to: apps/customer/.env
# Used by: Vite build + Capacitor Android (iq.mahalak.app)
# =============================================================================

# OneSignal App ID — create a SEPARATE app in OneSignal dashboard for the customer app.
# Required for native Android/iOS push token registration via onesignal-cordova-plugin.
# Vite injects this at build time (envPrefix: VITE_, envDir: apps/customer).
VITE_ONESIGNAL_APP_ID=YOUR_CUSTOMER_ONESIGNAL_APP_ID

# Optional fallback: packages/config/firebase.config.json → oneSignalAppId
# Do NOT commit real IDs to git — keep them in .env only.
