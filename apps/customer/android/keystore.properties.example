# Copy to keystore.properties (same folder) — use the SAME keystore from Play version 5.
# Do NOT create a new keystore for customer updates.
#
# storeFile is relative to apps/customer/android/ unless you use an absolute path.
storeFile=mahalak-release.keystore
storePassword=YOUR_STORE_PASSWORD
keyAlias=mahalak
keyPassword=YOUR_KEY_PASSWORD
