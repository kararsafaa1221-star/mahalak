# Copy to keystore.properties (same folder) — NEW keystore for merchant (iq.mahalak.merchant).
# Do NOT reuse the customer keystore (iq.mahalak.app).
#
# storeFile is relative to apps/merchant/android/ unless you use an absolute path.
storeFile=mahalak-merchant.jks
storePassword=YOUR_STORE_PASSWORD
keyAlias=mahalak-merchant
keyPassword=YOUR_KEY_PASSWORD
