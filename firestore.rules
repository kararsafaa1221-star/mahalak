rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }
    function isAdminDoc() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function adminDoc() {
      return get(/databases/$(database)/documents/admins/$(request.auth.uid)).data;
    }
    function isDashboardStaff() {
      return isAdminDoc() && (
        adminDoc().role == 'owner' ||
        !(adminDoc().status == 'suspended' || adminDoc().isSuspended == true)
      );
    }

    /** Role-based page access — mirrors admin-dashboard ROLE_PERMISSION_MATRIX. */
    function roleHasPageAccess(perm) {
      return isDashboardStaff() && (
        adminDoc().role == 'owner' ||
        adminDoc().role == 'admin' ||
        (adminDoc().role == 'supervisor' && (perm == 'stores' || perm == 'orders')) ||
        (adminDoc().role == 'support' && (perm == 'customers' || perm == 'orders')) ||
        (adminDoc().role == 'accountant' && (perm == 'subscriptions' || perm == 'payouts'))
      );
    }

    /** @deprecated use roleHasPageAccess — kept for gradual migration */
    function hasDashboardPermission(perm) {
      return roleHasPageAccess(perm);
    }

    function canReadCustomersAsStaff() {
      return isDashboardStaff();
    }

    /** Owner or supervisor — activity log read access. */
    function isSuperAdmin() {
      return isDashboardStaff() && (
        adminDoc().role == 'owner' ||
        adminDoc().role == 'supervisor'
      );
    }

    function incoming() { return request.resource.data; }

    function isCustomerSelf(customerId) {
      return isSignedIn() && (
        request.auth.uid == customerId ||
        resource.data.get('authUid', '') == request.auth.uid
      );
    }

    function notificationBelongsToUser() {
      return isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        (
          exists(/databases/$(database)/documents/customers/$(resource.data.userId))
          && get(/databases/$(database)/documents/customers/$(resource.data.userId)).data.get('authUid', '') == request.auth.uid
        )
      );
    }

    function isAuthUidSelfLookup() {
      return request.query.limit <= 2 && resource.data.authUid == request.auth.uid;
    }

    function canLinkCustomerAuthUid() {
      return isSignedIn()
        && incoming().get('authUid', '') == request.auth.uid
        && incoming().diff(resource.data).affectedKeys().hasOnly(['authUid']);
    }

    match /admins/{adminId} {
      allow read: if isOwner(adminId) || isDashboardStaff();
      allow write: if isDashboardStaff() && adminDoc().role == 'owner';
    }

    match /customers/{customerId} {
      allow get: if isCustomerSelf(customerId) || canReadCustomersAsStaff();
      allow list: if canReadCustomersAsStaff() || (isSignedIn() && isAuthUidSelfLookup());
      allow create: if isSignedIn() && (
        isOwner(customerId) ||
        incoming().get('authUid', request.auth.uid) == request.auth.uid
      );
      allow update: if isCustomerSelf(customerId)
        || roleHasPageAccess('customers')
        || canLinkCustomerAuthUid();
      allow delete: if roleHasPageAccess('customers');
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId) || roleHasPageAccess('settings');
    }

    match /stores/{storeId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isOwner(storeId) || roleHasPageAccess('stores');
      allow delete: if roleHasPageAccess('stores');
    }

    match /products/{productId} {
      allow read: if true;
      allow create: if isSignedIn() && (
        incoming().storeId == request.auth.uid || roleHasPageAccess('products')
      );
      allow update, delete: if isSignedIn()
        && (resource.data.storeId == request.auth.uid || roleHasPageAccess('products'));
    }

    match /orders/{orderId} {
      allow get: if isSignedIn() && (
        resource.data.customerId == request.auth.uid ||
        resource.data.storeId == request.auth.uid ||
        (
          exists(/databases/$(database)/documents/customers/$(resource.data.customerId))
          && get(/databases/$(database)/documents/customers/$(resource.data.customerId)).data.get('authUid', '') == request.auth.uid
        ) ||
        roleHasPageAccess('orders')
      );
      allow list: if isSignedIn();
      allow create: if isSignedIn() && incoming().customerId == request.auth.uid;
      allow update: if isSignedIn() && (
        roleHasPageAccess('orders') ||
        (resource.data.storeId == request.auth.uid
          && incoming().diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])) ||
        (resource.data.customerId == request.auth.uid
          && incoming().diff(resource.data).affectedKeys().hasOnly(['updatedAt']))
      );
      allow delete: if roleHasPageAccess('orders');
    }

    match /store_reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() || roleHasPageAccess('reviews');
      allow delete: if roleHasPageAccess('reviews');
    }

    match /notifications/{notificationId} {
      allow read: if notificationBelongsToUser() || roleHasPageAccess('broadcast');
      allow create: if isSignedIn();
      allow update: if notificationBelongsToUser() || roleHasPageAccess('broadcast');
      allow delete: if roleHasPageAccess('broadcast');
    }

    match /flash_sales/{saleId} {
      allow read: if true;
      allow write: if roleHasPageAccess('flashSales');
    }

    match /flash_sale_requests/{requestId} {
      allow read: if isSignedIn()
        && (resource.data.storeId == request.auth.uid || roleHasPageAccess('flashSales'));
      allow create: if isSignedIn() && incoming().storeId == request.auth.uid;
      allow update, delete: if roleHasPageAccess('flashSales');
    }

    match /promo_codes/{codeId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() || roleHasPageAccess('promoCodes');
      allow delete: if roleHasPageAccess('promoCodes');
    }

    match /promoCodes/{codeId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() || roleHasPageAccess('promoCodes');
      allow delete: if roleHasPageAccess('promoCodes');
    }

    match /recharge_codes/{codeId} {
      allow read: if isSignedIn();
      allow create: if roleHasPageAccess('rechargeCodes');
      allow update: if isSignedIn() || roleHasPageAccess('rechargeCodes');
      allow delete: if roleHasPageAccess('rechargeCodes');
    }

    match /payoutRequests/{requestId} {
      allow read: if isSignedIn()
        && (resource.data.merchantId == request.auth.uid || roleHasPageAccess('payouts'));
      allow create: if isSignedIn() && incoming().merchantId == request.auth.uid;
      allow update, delete: if roleHasPageAccess('payouts');
    }

    match /reels/{reelId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    match /reel_comments/{commentId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() || roleHasPageAccess('reviews');
    }

    match /activityLogs/{logId} {
      allow read: if isSuperAdmin();
      allow create: if isSignedIn()
        && request.resource.data.adminUid == request.auth.uid;
      allow update, delete: if false;
    }

    match /otp_tokens/{tokenId} {
      allow read, write: if false;
    }

    match /otp_attempts/{attemptId} {
      allow read, write: if false;
    }

    match /recharge_attempts/{attemptId} {
      allow read, write: if false;
    }

    match /test/{docId} {
      allow read: if true;
    }

    match /settings/global {
      allow read: if true;
      allow write: if roleHasPageAccess('settings') || roleHasPageAccess('subscriptions');
    }
  }
}
