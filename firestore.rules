rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }
    function isAdminDoc() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function adminDoc() {
      return get(/databases/$(database)/documents/admins/$(request.auth.uid)).data;
    }
    function isDashboardStaff() {
      return isAdminDoc() && (
        adminDoc().role == 'owner' ||
        !(adminDoc().status == 'suspended' || adminDoc().isSuspended == true)
      );
    }

    function roleHasPageAccess(perm) {
      return isDashboardStaff() && (
        adminDoc().role == 'owner' ||
        adminDoc().role == 'admin' ||
        (adminDoc().role == 'supervisor' && (perm == 'stores' || perm == 'orders' || perm == 'activityLogs')) ||
        (adminDoc().role == 'support' && (perm == 'customers' || perm == 'orders')) ||
        (adminDoc().role == 'accountant' && (perm == 'subscriptions' || perm == 'payouts'))
      );
    }

    function hasDashboardPermission(perm) {
      return roleHasPageAccess(perm);
    }

    function canReadCustomersAsStaff() {
      return roleHasPageAccess('customers');
    }

    function isSuperAdmin() {
      return isDashboardStaff() && (
        adminDoc().role == 'owner' ||
        adminDoc().role == 'supervisor'
      );
    }

    function incoming() { return request.resource.data; }

    function storeData(storeId) {
      return get(/databases/$(database)/documents/stores/$(storeId)).data;
    }

    function ownsStore(storeId) {
      return isSignedIn()
        && storeId is string
        && storeId != ''
        && exists(/databases/$(database)/documents/stores/$(storeId))
        && storeData(storeId).get('ownerId', '') == request.auth.uid;
    }

    function isCustomerSelf(customerId) {
      return isSignedIn() && (
        request.auth.uid == customerId ||
        resource.data.get('authUid', '') == request.auth.uid
      );
    }

    function ownsCustomerId(customerId) {
      return isSignedIn() && (
        customerId == request.auth.uid ||
        (
          exists(/databases/$(database)/documents/customers/$(customerId))
          && get(/databases/$(database)/documents/customers/$(customerId)).data.get('authUid', '') == request.auth.uid
        )
      );
    }

    function notificationBelongsToUser() {
      return isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        ownsCustomerId(resource.data.userId) ||
        ownsStore(resource.data.userId)
      );
    }

    /** Merchant sends a targeted notification to one of their customers (e.g. gift). */
    function merchantNotifiesCustomer() {
      return incoming().role == 'customer'
        && incoming().userId is string
        && incoming().senderStoreId is string
        && ownsStoreSecrets(incoming().senderStoreId);
    }

    /** Notifications: no arbitrary cross-user spam from merchants. Bulk sends use Cloud Functions. */
    function canCreateNotification() {
      return isSignedIn() && (
        roleHasPageAccess('broadcast') ||
        ownsStore(incoming().userId) ||
        merchantNotifiesCustomer() ||
        (
          ownsCustomerId(incoming().userId)
          && incoming().get('senderStoreId', '') == ''
        )
      );
    }

    function isAuthUidSelfLookup() {
      return request.query.limit <= 2 && resource.data.authUid == request.auth.uid;
    }

    function customerSelfProfileUpdate() {
      return isCustomerSelf(customerId) && !incoming().diff(resource.data).affectedKeys().hasAny([
        'points', 'tier', 'isBlocked', 'ordersCount', 'monthlyOrdersCount', 'authUid', 'password',
        'blockedStoreIds'
      ]);
    }

    // Staff (support/admin) may update customer profiles but must NOT touch
    // financially or security-sensitive fields — those are Cloud Function only.
    function customerStaffUpdateSafe() {
      return !incoming().diff(resource.data).affectedKeys().hasAny([
        'points', 'tier', 'isBlocked', 'monthlyOrdersCount', 'ordersCount',
        'authUid', 'password', 'blockedStoreIds'
      ]);
    }

    function storeOwnerProfileUpdate() {
      return !incoming().diff(resource.data).affectedKeys().hasAny([
        'isVerified', 'verificationType', 'verificationExpiresAt',
        'walletBalance', 'payoutMethods', 'password',
        'subscriptionStatus', 'subscriptionValidUntil',
        'subscriptionExpiry', 'subscriptionExpiryDate', 'subscriptionId',
        'autoSubscriptionDuration', 'autoSubscriptionDisabled', 'status',
        'rating', 'totalReviews', 'blockedCustomerIds'
      ]);
    }

    function storeOwnerSafeCreate() {
      let d = request.resource.data;
      let status = d.get('status', 'pending');
      return d.get('ownerId', request.auth.uid) == request.auth.uid
        && (status == 'pending' || status == 'active')
        && d.get('subscriptionStatus', 'none') == 'none'
        && d.get('subscriptionExpiry', 'none') == 'none'
        && d.get('subscriptionExpiryDate', 'none') == 'none'
        && !d.keys().hasAny(['subscriptionValidUntil', 'autoSubscriptionDuration'])
        && d.get('autoSubscriptionDisabled', false) == false
        && !d.keys().hasAny(['walletBalance', 'payoutMethods', 'password']);
    }

    function ownsStoreSecrets(storeId) {
      return isSignedIn()
        && storeId is string
        && storeId != ''
        && (
          ownsStore(storeId)
          || (
            exists(/databases/$(database)/documents/store_secrets/$(storeId))
            && get(/databases/$(database)/documents/store_secrets/$(storeId)).data.get('ownerId', '') == request.auth.uid
          )
        );
    }

    // Fields that track coupon lifecycle — only Cloud Functions (Admin SDK) or
    // privileged staff may change these. Store owners updating their own codes
    // are blocked from touching any of these. Customers have no update path at
    // all (see promo_codes rules below), so this is defence-in-depth for
    // store-owner writes only.
    function promoFieldsSafe() {
      return !incoming().diff(resource.data).affectedKeys().hasAny([
        'status', 'usedCount', 'currentGlobalUses',
        'maxUses', 'maxGlobalUses',
        'expirationDate', 'expiresAt',
        'ownerCustomerId', 'source'
      ]) || roleHasPageAccess('promoCodes');
    }

    // Staff may only touch these order fields; all financial fields are CF-only.
    function orderStaffFieldsSafe() {
      return incoming().diff(resource.data).affectedKeys()
        .hasOnly(['status', 'updatedAt', 'rejectionReason', 'returnReason',
                  'notes', 'deliveryRewardsApplied']);
    }

    // deliveryRewardsApplied may only be SET (true), never cleared.
    function rewardsFlagSafe(affectedKeys) {
      return !affectedKeys.hasAny(['deliveryRewardsApplied'])
        || incoming().deliveryRewardsApplied == true;
    }

    // Enforce a valid status-machine transition for merchant order updates.
    function merchantStatusTransitionValid() {
      let from = resource.data.get('status', 'pending');
      let to = incoming().get('status', from);
      return (from == 'pending'   && (to == 'accepted'  || to == 'rejected' || to == 'cancelled'))
          || (from == 'accepted'  && (to == 'preparing' || to == 'shipped'  || to == 'rejected' || to == 'cancelled'))
          || (from == 'preparing' && (to == 'shipped'   || to == 'rejected' || to == 'cancelled'))
          || (from == 'shipped'   && (to == 'delivered' || to == 'returned' || to == 'replaced'))
          || (from == 'delivered' && (to == 'returned'  || to == 'replaced'));
    }

    // Customer 30s cancel window — merchant cannot act until grace expires.
    function merchantOrderGracePassed() {
      return !resource.data.keys().hasAny(['customerGraceUntil'])
        || request.time >= resource.data.customerGraceUntil;
    }

    // Customer may self-cancel only while the order is still pending (grace window enforced in UI).
    function customerCancelPendingAllowed() {
      let affectedKeys = incoming().diff(resource.data).affectedKeys();
      return ownsCustomerId(resource.data.customerId)
        && resource.data.get('status', '') == 'pending'
        && incoming().get('status', '') == 'cancelled'
        && affectedKeys.hasOnly(['status', 'updatedAt', 'rejectionReason']);
    }

    function orderStatusTransitionAllowed() {
      let affectedKeys = incoming().diff(resource.data).affectedKeys();
      return (roleHasPageAccess('orders')
                && rewardsFlagSafe(affectedKeys)
                && orderStaffFieldsSafe())
          || (ownsStore(resource.data.storeId)
                && merchantOrderGracePassed()
                && affectedKeys.hasOnly(['status', 'updatedAt', 'rejectionReason', 'returnReason'])
                && merchantStatusTransitionValid())
          || merchantInboxClearAllowed(affectedKeys)
          || customerCancelPendingAllowed();
    }

    // Merchant may hide closed orders from their inbox UI only (no status/finance change).
    function merchantInboxClearAllowed(affectedKeys) {
      let st = resource.data.status;
      return ownsStore(resource.data.storeId)
        && merchantOrderGracePassed()
        && affectedKeys.hasOnly(['merchantInboxCleared', 'merchantInboxClearedAt'])
        && (st == 'delivered' || st == 'returned' || st == 'replaced' || st == 'rejected' || st == 'cancelled')
        && incoming().get('merchantInboxCleared', false) == true;
    }

    match /admins/{adminId} {
      allow read: if isOwner(adminId) || isDashboardStaff();
      allow write: if isDashboardStaff() && adminDoc().role == 'owner';
      // Any dashboard staff may write push-notification fields to their own document only.
      // Covers both update (doc exists) and create (first setDoc with merge:true).
      allow update: if isDashboardStaff()
        && request.auth.uid == adminId
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['fcmToken', 'oneSignalId', 'pushEnabled']);
      allow create: if isDashboardStaff()
        && request.auth.uid == adminId
        && request.resource.data.keys().hasOnly(['fcmToken', 'oneSignalId', 'pushEnabled']);
    }

    match /auth_secrets/{secretId} {
      allow read, write: if false;
    }

    match /customers/{customerId} {
      allow get: if isCustomerSelf(customerId) || canReadCustomersAsStaff();
      allow list: if canReadCustomersAsStaff() || (isSignedIn() && isAuthUidSelfLookup());
      allow create: if isSignedIn() && (
        isOwner(customerId) ||
        incoming().get('authUid', request.auth.uid) == request.auth.uid
      ) && !incoming().keys().hasAny(['password'])
        && incoming().get('points', 0) == 0
        && incoming().get('isBlocked', false) == false;
      // Self-update: blocklist protects sensitive fields.
      // Staff-update: same blocklist; points/isBlocked are Cloud Function only.
      allow update: if customerSelfProfileUpdate()
        || (roleHasPageAccess('customers') && customerStaffUpdateSafe());
      allow delete: if roleHasPageAccess('customers');
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId) || roleHasPageAccess('settings');
    }

    /** Public catalog — safe fields only; synced from stores via Cloud Functions (Admin SDK). */
    match /stores_public/{storeId} {
      allow read: if true;
      allow update: if ownsStoreSecrets(storeId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['storeTheme']);
      allow create, delete: if false;
    }

    match /stores/{storeId} {
      allow get, list: if ownsStore(storeId)
        || roleHasPageAccess('stores')
        || roleHasPageAccess('payouts');
      allow create: if isSignedIn()
        && incoming().get('ownerId', request.auth.uid) == request.auth.uid
        && storeOwnerSafeCreate();
      allow update: if (ownsStore(storeId) && storeOwnerProfileUpdate())
        || roleHasPageAccess('stores');
      allow delete: if roleHasPageAccess('stores');
    }

    match /store_secrets/{storeId} {
      allow read: if ownsStoreSecrets(storeId)
        || roleHasPageAccess('stores')
        || roleHasPageAccess('payouts');
      allow create: if ownsStore(storeId)
        && incoming().storeId == storeId
        && incoming().get('ownerId', request.auth.uid) == request.auth.uid
        && !incoming().keys().hasAny(['walletBalance']);
      // Merchants: may update own secrets but NOT walletBalance (CF only).
      // Stores/owner staff: full update access.
      // Accountants (payouts): read-audit only; may not write walletBalance or ownerId.
      allow update: if (ownsStoreSecrets(storeId)
            && !incoming().diff(resource.data).affectedKeys().hasAny(['walletBalance']))
        || roleHasPageAccess('stores')
        || (roleHasPageAccess('payouts')
            && !incoming().diff(resource.data).affectedKeys().hasAny(['walletBalance', 'ownerId']));
      allow delete: if roleHasPageAccess('stores') && adminDoc().role == 'owner';
    }

    match /products/{productId} {
      // Require Firebase auth (anonymous counts) to prevent raw unauthenticated
      // API scraping of costPrice and inventory fields.
      // Firestore does not support field-level security; all authenticated users
      // (including anonymous app sessions) receive the full document.
      // Store owners and staff always have full read access.
      allow read: if isSignedIn()
        || ownsStore(resource.data.storeId)
        || roleHasPageAccess('products');
      allow create: if isSignedIn() && (
        ownsStore(incoming().storeId) || roleHasPageAccess('products')
      );
      allow update: if isSignedIn() && (
        ownsStore(resource.data.storeId) ||
        roleHasPageAccess('products')
      );
      allow delete: if isSignedIn()
        && (ownsStore(resource.data.storeId) || roleHasPageAccess('products'));
    }

    match /orders/{orderId} {
      allow get: if isSignedIn() && (
        ownsCustomerId(resource.data.customerId) ||
        ownsStore(resource.data.storeId) ||
        roleHasPageAccess('orders')
      );
      allow list: if isSignedIn() && (
        ownsCustomerId(resource.data.customerId) ||
        ownsStore(resource.data.storeId) ||
        roleHasPageAccess('orders')
      );
      // All order creation goes through placeOrderSecure (Admin SDK) — no client writes.
      allow create: if false;
      allow update: if isSignedIn() && orderStatusTransitionAllowed();
      allow delete: if roleHasPageAccess('orders');
    }

    function storeReviewCreateAllowed(reviewId) {
      return isSignedIn()
        && ownsCustomerId(incoming().customerId)
        && incoming().storeId is string
        && incoming().storeId != ''
        && reviewId == incoming().storeId + '_' + request.auth.uid
        && !exists(/databases/$(database)/documents/store_reviews/$(reviewId));
    }

    match /store_reviews/{reviewId} {
      allow read: if true;
      allow create: if roleHasPageAccess('reviews') || storeReviewCreateAllowed(reviewId);
      allow update: if ownsCustomerId(resource.data.customerId) || roleHasPageAccess('reviews');
      allow delete: if roleHasPageAccess('reviews') || ownsCustomerId(resource.data.customerId);
    }

    match /product_reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn() && ownsCustomerId(incoming().customerId);
      allow update: if ownsCustomerId(resource.data.customerId) || roleHasPageAccess('reviews');
      allow delete: if roleHasPageAccess('reviews') || ownsCustomerId(resource.data.customerId);
    }

    match /notifications/{notificationId} {
      allow read: if notificationBelongsToUser() || roleHasPageAccess('broadcast');
      allow create: if canCreateNotification();
      allow update: if notificationBelongsToUser() || roleHasPageAccess('broadcast');
      allow delete: if notificationBelongsToUser() || roleHasPageAccess('broadcast');
    }

    match /flash_sales/{saleId} {
      allow read: if true;
      allow write: if roleHasPageAccess('flashSales');
    }

    match /flash_sale_requests/{requestId} {
      allow read: if isSignedIn()
        && (ownsStore(resource.data.storeId) || roleHasPageAccess('flashSales'));
      allow create: if isSignedIn() && ownsStore(incoming().storeId);
      allow update, delete: if roleHasPageAccess('flashSales');
    }

    // Customers can READ their own personal promo codes (ownerCustomerId match)
    // but have ZERO write path — create/update/delete are all restricted to
    // staff or the store that owns the code. Lifecycle fields (status, usedCount,
    // expiresAt, …) are further protected by promoFieldsSafe() so even store
    // owners cannot forge them. All status transitions are done by Cloud
    // Functions via the Admin SDK which bypasses these rules.
    match /promo_codes/{codeId} {
      allow get: if isSignedIn() && (
        roleHasPageAccess('promoCodes')
        || ownsStore(resource.data.storeId)
        || (
          resource.data.get('ownerCustomerId', '') != ''
          && ownsCustomerId(resource.data.ownerCustomerId)
        )
      );
      allow list: if isSignedIn() && (
        roleHasPageAccess('promoCodes')
        || ownsStore(resource.data.storeId)
        || (
          resource.data.get('ownerCustomerId', '') != ''
          && ownsCustomerId(resource.data.ownerCustomerId)
        )
      );
      // Customers may NOT create promo codes — only staff or the owning store.
      allow create: if isSignedIn() && (
        roleHasPageAccess('promoCodes') || ownsStore(incoming().storeId)
      );
      // Customers may NOT update promo codes. Store owners may update safe fields
      // only (promoFieldsSafe blocks status, usedCount, expiry, etc.).
      allow update: if roleHasPageAccess('promoCodes')
        || (ownsStore(resource.data.storeId) && promoFieldsSafe());
      // Customers may NOT delete promo codes.
      allow delete: if roleHasPageAccess('promoCodes') || ownsStore(resource.data.storeId);
    }

    // Legacy collection — same rules as promo_codes above.
    match /promoCodes/{codeId} {
      allow get: if isSignedIn() && (
        roleHasPageAccess('promoCodes')
        || ownsStore(resource.data.storeId)
        || (
          resource.data.get('ownerCustomerId', '') != ''
          && ownsCustomerId(resource.data.ownerCustomerId)
        )
      );
      allow list: if isSignedIn() && (
        roleHasPageAccess('promoCodes')
        || ownsStore(resource.data.storeId)
        || (
          resource.data.get('ownerCustomerId', '') != ''
          && ownsCustomerId(resource.data.ownerCustomerId)
        )
      );
      allow create: if isSignedIn() && (
        roleHasPageAccess('promoCodes') || ownsStore(incoming().storeId)
      );
      allow update: if roleHasPageAccess('promoCodes')
        || (ownsStore(resource.data.storeId) && promoFieldsSafe());
      allow delete: if roleHasPageAccess('promoCodes') || ownsStore(resource.data.storeId);
    }

    match /recharge_codes/{codeId} {
      allow read: if isSignedIn() && roleHasPageAccess('rechargeCodes');
      allow create: if roleHasPageAccess('rechargeCodes');
      allow update, delete: if roleHasPageAccess('rechargeCodes');
    }

    match /payoutRequests/{requestId} {
      allow read: if isSignedIn()
        && (ownsStore(resource.data.merchantId) || roleHasPageAccess('payouts'));
      allow create: if isSignedIn() && ownsStore(incoming().merchantId);
      allow update, delete: if roleHasPageAccess('payouts');
    }

    match /reels/{reelId} {
      allow read: if true;
      allow create: if isSignedIn() && ownsStore(incoming().storeId);
      allow update: if ownsStore(resource.data.storeId) || roleHasPageAccess('reviews');
      allow delete: if ownsStore(resource.data.storeId) || roleHasPageAccess('reviews');
    }

    match /reel_comments/{commentId} {
      allow read: if true;
      allow create: if isSignedIn()
        && incoming().userId == request.auth.uid;
      allow update, delete: if isSignedIn() && (
        resource.data.userId == request.auth.uid || roleHasPageAccess('reviews')
      );
    }

    match /activityLogs/{logId} {
      allow read: if isSuperAdmin();
      allow create: if isDashboardStaff()
        && request.resource.data.adminUid == request.auth.uid;
      allow update, delete: if false;
    }

    match /otp_tokens/{tokenId} {
      allow read, write: if false;
    }

    match /otp_attempts/{attemptId} {
      allow read, write: if false;
    }

    match /recharge_attempts/{attemptId} {
      allow read, write: if false;
    }

    match /login_attempts/{attemptId} {
      allow read, write: if false;
    }

    match /unique_phones/{phoneKey} {
      allow read: if false;
      allow create: if isSignedIn()
        && !exists(/databases/$(database)/documents/unique_phones/$(phoneKey))
        && incoming().entityId is string
        && (incoming().entityType == 'customer' || incoming().entityType == 'store');
      allow update, delete: if roleHasPageAccess('customers') || roleHasPageAccess('stores');
    }

    match /unique_usernames/{usernameKey} {
      allow read: if false;
      allow create: if isSignedIn()
        && !exists(/databases/$(database)/documents/unique_usernames/$(usernameKey))
        && incoming().storeId is string;
      allow update, delete: if roleHasPageAccess('stores');
    }

    match /blocked_phones/{phoneKey} {
      // Signup checks a single phone key by document id (not a collection list).
      allow get: if isSignedIn();
      allow list: if isDashboardStaff();
      allow create, update, delete: if roleHasPageAccess('customers') || roleHasPageAccess('stores');
    }

    match /share_rewards/{rewardId} {
      allow read, write: if false;
    }

    match /store_audience/{storeId} {
      match /members/{memberId} {
        allow read: if ownsStore(storeId);
        allow write: if false;
      }
    }

    match /marketing_share_stats/{storeId} {
      allow read: if ownsStore(storeId);

      allow create: if incoming().storeId == storeId
        && incoming().totalVisits == 1
        && (
          (incoming().storeLinkVisits == 1 && incoming().productLinkVisits == 0) ||
          (incoming().storeLinkVisits == 0 && incoming().productLinkVisits == 1)
        );

      allow update: if incoming().storeId == storeId
        && incoming().totalVisits == resource.data.get('totalVisits', 0) + 1
        && (
          (
            incoming().storeLinkVisits == resource.data.get('storeLinkVisits', 0) + 1
            && incoming().productLinkVisits == resource.data.get('productLinkVisits', 0)
          ) ||
          (
            incoming().productLinkVisits == resource.data.get('productLinkVisits', 0) + 1
            && incoming().storeLinkVisits == resource.data.get('storeLinkVisits', 0)
          )
        );

      match /product_stats/{productId} {
        allow read: if ownsStore(storeId);
        allow create: if incoming().visits == 1;
        allow update: if incoming().visits == resource.data.get('visits', 0) + 1;
      }
    }

    match /counters/{counterId} {
      allow read, write: if false;
    }

    match /test/{docId} {
      allow read, write: if false;
    }

    match /settings/global {
      allow read: if true;
      allow write: if roleHasPageAccess('settings') || roleHasPageAccess('subscriptions');
    }

    match /settings_internal/{docId} {
      allow read, write: if roleHasPageAccess('settings');
    }
  }
}
