rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isDashboardStaff() {
      return isSignedIn()
        && firestore.exists(/databases/default/documents/admins/$(request.auth.uid));
    }

    match /{allPaths=**} {
      allow read: if true;
      allow write: if isSignedIn();
      allow delete: if isDashboardStaff();
    }
  }
}
